# MODE=fake runs everything offline with a deterministic forecaster and decision model. No spend.
# MODE=live uses the forecasting dashboard and (if a key is set) the Jev decision model.
MODE=fake
PORT=8787
# Public address of the app, used in share links and the notification URL. https in production.
PUBLIC_BASE_URL=http://localhost:8787
DB_PATH=./data/wishes.db

# Spend caps. Placeholders until set by the owner.
WISH_MAX_USD=2
DAILY_WISH_LIMIT=25
CHECKS_PER_HOUR=20
WISH_TIMEOUT_MIN=45
# A run that fails is started again this many times before the wish is given back.
WISH_RETRIES=1
INVITES_PER_USER=0

# Questions further out than this are turned away (days). Nearer than MIN_HORIZON_DAYS too.
MAX_HORIZON_DAYS=1095
MIN_HORIZON_DAYS=1

# Required for GET /admin/stats
ADMIN_TOKEN=change-me

# Behind a proxy or tunnel, trust X-Forwarded-For for rate limits.
TRUST_PROXY=0

# --- live mode: the forecasting dashboard (acts as the identity of the token) ---
FORECASTER_BASE_URL=https://dashboard.dev.foundationresearch.ai
# Either the token itself or a file holding it. Never commit either.
FORECASTER_TOKEN=
FORECASTER_TOKEN_FILE=~/.config/foundation-forecasts/token
# Organization (id or slug) the wishes are created in.
FORECASTER_ORG=foundation
FORECASTER_DEPTH=light

# --- live mode: the decision model that checks a question's form ---
# DECIDER=bedrock uses Claude on Amazon Bedrock (AWS credentials from the environment's role);
# DECIDER=jev uses the Jev Decisions API below; DECIDER=none uses the rules alone.
# Left empty: Jev if JEV_API_KEY is set, otherwise Bedrock.
DECIDER=
DECIDER_MODEL=us.anthropic.claude-haiku-5-5
DECIDER_TIMEOUT_MS=8000
JEV_API_KEY=
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.14
JEV_MIN_PROB=0.5

# --- Native iPhone app push (Apple Developer > Keys > APNs; see ios/README.md) ---
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=ai.foundationresearch.iii

# --- Web Push (npm run vapid prints a pair) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
