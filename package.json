{
  "name": "three-wishes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Invite-only iPhone app: three questions about the future, answered on a lever.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "dev": "MODE=fake node --disable-warning=ExperimentalWarning --watch server/index.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/unit/*.test.mjs\" \"test/api/*.test.mjs\"",
    "test:e2e": "node --disable-warning=ExperimentalWarning test/e2e/run.mjs",
    "admin": "node --disable-warning=ExperimentalWarning bin/admin.mjs",
    "assets": "node scripts/build-assets.mjs",
    "vapid": "node scripts/vapid.mjs",
    "demo": "node --disable-warning=ExperimentalWarning scripts/demo.mjs",
    "demo:tunnel": "node --disable-warning=ExperimentalWarning scripts/demo.mjs --tunnel",
    "preview:live": "MODE=live DECIDER=bedrock PORT=8788 DEMO_HOST=127.0.0.1 DEMO_DB=./data/live-preview.db DAILY_WISH_LIMIT=1 WISH_MAX_USD=2 WISH_RETRIES=0 npm run demo",
    "decider-check": "node --disable-warning=ExperimentalWarning scripts/decider-check.mjs",
    "assets:ios": "node scripts/build-ios-assets.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1173.0",
    "sharp": "^0.34.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "playwright-core": "^1.50.0"
  }
}
